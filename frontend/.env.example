# ==============================================================================
# CraftyKidsCo - Frontend Environment Configuration Example
# Copy this file to .env and provide your secret values.
# ==============================================================================

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"
BACKEND_URL="http://localhost:5000"

# Brand & Storefront
NEXT_PUBLIC_BRAND_NAME_EN="CraftyKidsCo"
NEXT_PUBLIC_BRAND_NAME_BN="ক্রাফটিকিডস কো"
NEXT_PUBLIC_DEFAULT_CURRENCY="BDT"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"

# Database (MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=""
MONGODB_DB_NAME="craftykidsco"

# Media Storage (ImgBB API)
IMGBB_API_KEY=""
NEXT_PUBLIC_IMGBB_API_KEY=""

# ------------------------------------------------------------------------------
# Authentication & Admin Security
# JWT_SECRET must be at least 32 characters long
# ------------------------------------------------------------------------------
JWT_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# Courier Integration (Steadfast Courier API)
# ------------------------------------------------------------------------------
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"
USE_MOCK_COURIER="false"
USE_MOCK_PAYMENTS="true"

# ------------------------------------------------------------------------------
# SMS Notification Gateway (BulkSMSBD)
# ------------------------------------------------------------------------------
BULKSMSBD_API_KEY=""
SMS_API_KEY=""
SMS_SENDER_ID="CraftyKids"

# ------------------------------------------------------------------------------
# Mobile Financial Services (bKash & Nagad Merchant Numbers)
# ------------------------------------------------------------------------------
BKASH_MERCHANT_NUMBER=""
NAGAD_MERCHANT_NUMBER=""

# ------------------------------------------------------------------------------
# Email Notifications (Gmail SMTP / Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
NOTIFY_EMAIL=""
