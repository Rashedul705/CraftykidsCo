# ==============================================================================
# CraftyKidsCo - Environment Configuration Example
# ==============================================================================

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="https://example.com"
NEXT_PUBLIC_API_URL="https://api.example.com"

# Store & Brand Info
NEXT_PUBLIC_BRAND_NAME_EN="CraftyKidsCo"
NEXT_PUBLIC_BRAND_NAME_BN="ক্রাফটিকিডস কো"
NEXT_PUBLIC_DEFAULT_CURRENCY="BDT"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"

# Database (MongoDB Atlas / PostgreSQL)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"
MONGODB_DB_NAME="craftykidsco"
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?schema=public"

# Auth & Admin Security
# Must be at least 32 characters, and must not contain insecure default words
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-secure-admin-password"

# ==============================================================================
# INTEGRATIONS (Configure with your credentials)
# ==============================================================================
# Steadfast Courier API
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_BASE_URL="https://portal.steadfast.courier/api/v1"

# Payment Gateways (bKash & Nagad)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""

# SMS Gateway
SMS_API_KEY=""
SMS_SENDER_ID="CraftyKids"

# Cloud Image Storage (ImgBB)
IMGBB_API_KEY=""
NEXT_PUBLIC_IMGBB_API_KEY=""
