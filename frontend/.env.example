# ==============================================================================
# CraftyKidsCo - Environment Configuration
# ==============================================================================

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="https://ckcbk.maxapi.esp32.site"

# Store & Brand Info
NEXT_PUBLIC_BRAND_NAME_EN="CraftyKidsCo"
NEXT_PUBLIC_BRAND_NAME_BN="CraftyKidsCo"
NEXT_PUBLIC_DEFAULT_CURRENCY="BDT"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"

# Database (MongoDB Atlas / Local MongoDB)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/craftykidsco?retryWrites=true&w=majority"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kids_ecommerce?schema=public"

# Auth Secrets
JWT_SECRET="dev-secret-jwt-key-change-in-production-123456"
ADMIN_EMAIL="admin@craftykidsco.com"
ADMIN_PASSWORD="craftykids2026"

