{
  "name": "kids-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "server": "npm --prefix backend run dev",
    "dev:all": "concurrently -n \"FRONTEND,BACKEND\" -c \"cyan,magenta\" \"npm run dev\" \"npm run server\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "cleanup:variations": "tsx --env-file=.env scripts/cleanup-variations.ts",
    "cleanup:variations:commit": "tsx --env-file=.env scripts/cleanup-variations.ts --commit --disambiguate-skus"
  },
  "dependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@prisma/client": "^6.4.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "clsx": "^2.1.1",
    "jose": "^6.2.13",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.55.0",
    "mongoose": "^9.11.2",
    "next": "^16.4.2",
    "puppeteer-core": "^25.15.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bwip-js": "^3.2.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
