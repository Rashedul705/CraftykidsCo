# ==============================================================================
# CraftyKidsCo - Backend Environment Configuration Example
# Copy this file to .env and provide your secret values.
# ==============================================================================

PORT=5000
HOST=localhost
NODE_ENV=development
CORS_ORIGINS=https://craftykidsco.com,https://www.craftykidsco.com,http://localhost:3000
BACKEND_URL=http://localhost:5000

# Database (MongoDB Atlas)
MONGODB_URI=""
MONGODB_DB_NAME="craftykidsco"

# Image Storage (ImgBB API)
IMGBB_API_KEY=""

# Security & Admin Authentication
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Courier Integration (Steadfast Courier API)
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"

# SMS Notification Gateway (BulkSMSBD)
BULKSMSBD_API_KEY=""
SMS_API_KEY=""
SMS_SENDER_ID="CraftyKids"

# Mobile Financial Services (bKash & Nagad)
BKASH_MERCHANT_NUMBER=""
NAGAD_MERCHANT_NUMBER=""
