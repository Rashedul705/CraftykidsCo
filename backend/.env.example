PORT=5000
HOST=localhost
NODE_ENV=development
CORS_ORIGINS=https://craftykidsco.com,https://www.craftykidsco.com
BACKEND_URL=https://api.example.com

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=craftykidsco

# Image Storage (ImgBB API)
IMGBB_API_KEY=replace-with-imgbb-api-key

# Security & Admin Authentication
# Must be at least 32 characters, and must not contain insecure default words
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-admin-password
