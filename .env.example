# ==============================================================================
# Rongdhonu Kids (রংধনু কিডস) - Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME_EN="Rongdhonu Kids"
NEXT_PUBLIC_BRAND_NAME_BN="রংধনু কিডস"
NEXT_PUBLIC_DEFAULT_CURRENCY="BDT"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kids_ecommerce?schema=public"

# Auth Secrets
ADMIN_EMAIL="admin@rongdhonukids.com"
ADMIN_PASSWORD_HASH="$2a$12$e..." # Secure bcrypt hash
JWT_SECRET="super-secret-jwt-key-replace-in-production-123456"

# Courier Integration - Steadfast API (Behind ICourierProvider)
STEADFAST_API_KEY="mock_steadfast_api_key_for_testing"
STEADFAST_SECRET_KEY="mock_steadfast_secret_key"
STEADFAST_BASE_URL="https://portal.steadfast.courier/api/v1"
USE_MOCK_COURIER="true"

# Payment Gateways (Behind IPaymentProvider)
BKASH_APP_KEY="mock_bkash_app_key"
BKASH_APP_SECRET="mock_bkash_app_secret"
BKASH_USERNAME="mock_bkash_username"
BKASH_PASSWORD="mock_bkash_password"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

NAGAD_MERCHANT_ID="mock_nagad_merchant_id"
NAGAD_PUBLIC_KEY="mock_nagad_public_key"
NAGAD_PRIVATE_KEY="mock_nagad_private_key"

USE_MOCK_PAYMENTS="true"

# SMS Gateway (Behind INotificationProvider)
SMS_API_KEY="mock_bangladeshi_sms_api_key"
SMS_SENDER_ID="Rongdhonu"
USE_MOCK_SMS="true"

# Delivery Charge Defaults (BDT integers)
DEFAULT_DELIVERY_INSIDE_DHAKA=60
DEFAULT_DELIVERY_OUTSIDE_DHAKA=120
DEFAULT_FREE_DELIVERY_MINIMUM=1000

# Image Storage (Cloudinary or Local)
CLOUDINARY_CLOUD_NAME="mock_cloud"
CLOUDINARY_API_KEY="mock_key"
CLOUDINARY_API_SECRET="mock_secret"
USE_MOCK_STORAGE="true"
